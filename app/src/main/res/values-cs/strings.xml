    <string name="settings_auto_backup_body">Automaticky zálohuje vaše data při přihlášení hlavním heslem (nikoli biometricky). Doporučujeme ponechat zapnuté.</string>

    <string name="settings_ask_for_pswrd_after_biometric_title">Vyžadovat heslo po %1$d biometrických přihlášeních.</string>
    <string name="settings_ask_for_pswrd_after_biometric_body">Limit pro počet po sobě jdoucích biometrických přihlášení. Po dosažení tohoto limitu bude k přihlášení vyžadováno heslo, abyste své hlavní heslo nezapomněli.</string>

    <string name="settings_away_timeout_title">Automatické uzamčení po %1$d s.</string>
    <string name="settings_away_timeout_body">Aplikace vás automaticky odhlásí, pokud ji delší dobu nepoužíváte. Kratší doba je bezpečnější.</string>

    <string name="settings_feedback_title">Odeslat zpětnou vazbu</string>
    <string name="settings_feedback_body">Nahlaste chybu nebo navrhněte novou funkci. Vážíme si vašich podnětů k vylepšování aplikace Safe Box.</string>

