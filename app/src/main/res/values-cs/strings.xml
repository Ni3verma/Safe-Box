    <string name="settings_privacy_enabled_title">Režim soukromí</string>
    <string name="settings_privacy_enabled_body">Skryje obsah aplikace v přehledu nedávných aplikací pro ochranu citlivých údajů a zakáže pořizování snímků obrazovky. Doporučujeme ponechat zapnuté.</string>

